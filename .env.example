# Local development environment variables
# DO NOT COMMIT THIS FILE — it is in .gitignore

# ── Required keys ─────────────────────────────────────────────────────────────
NVIDIA_API_KEY=your-nvapi-key-here
PIPELINE_SECRET=your-local-secret
WORKER_URL=http://localhost:8787

# ── Optional/Enrichment keys ──────────────────────────────────────────────────
PDL_API_KEY=your-pdl-key-here
HUNTER_API_KEY=your-hunter-key-here

# ── CRM & Notification keys (Worker specific) ─────────────────────────────────
HUBSPOT_ACCESS_TOKEN=your-hubspot-token-here
RESEND_API_KEY=your-resend-key-here
